{
  "framework": null,
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/aprender/",
      "destination": "/aprender",
      "permanent": false
    },
    {
      "source": "/telegestao",
      "destination": "/telegestao/",
      "permanent": false
    },
    {
      "source": "/gestor",
      "destination": "/gestor/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/aprender",
      "destination": "https://treinador-ecru.vercel.app/aprender"
    },
    {
      "source": "/aprender/:path*",
      "destination": "https://treinador-ecru.vercel.app/aprender/:path*"
    },
    {
      "source": "/gestor/",
      "destination": "https://delumo-gestor.vercel.app/gestor"
    },
    {
      "source": "/gestor/:path*",
      "destination": "https://delumo-gestor.vercel.app/gestor/:path*"
    },
    {
      "source": "/telegestao/",
      "destination": "https://telemetria-olive.vercel.app/"
    },
    {
      "source": "/telegestao/:path*",
      "destination": "https://telemetria-olive.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests; frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/(proposta[a-z0-9]*|orcamentocastelinho|convite|bora|redelius)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/gamelongines/Build/Web.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    },
    {
      "source": "/gamelongines/Build/Web.data",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    }
  ]
}
